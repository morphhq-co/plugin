{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "type": "command",
        "bash": "node \"${PLUGIN_ROOT}/hooks/morph-brain-hook.js\" session-start --format copilot",
        "powershell": "node \"${PLUGIN_ROOT}\\hooks\\morph-brain-hook.js\" session-start --format copilot",
        "timeoutSec": 10
      }
    ],
    "postToolUse": [
      {
        "type": "command",
        "bash": "node \"${PLUGIN_ROOT}/hooks/morph-brain-hook.js\" post-tool-use --format copilot",
        "powershell": "node \"${PLUGIN_ROOT}\\hooks\\morph-brain-hook.js\" post-tool-use --format copilot",
        "timeoutSec": 10
      }
    ]
  }
}
