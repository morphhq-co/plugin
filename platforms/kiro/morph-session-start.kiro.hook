{
  "enabled": true,
  "name": "Morph brain — session start",
  "description": "Pull shared organization guidance from the Morph brain at session start.",
  "version": "1",
  "when": {
    "type": "sessionStart"
  },
  "then": {
    "type": "askAgent",
    "prompt": "Using the morph MCP server, call its read tool with path \"brain/hooks/session-start.md\" and follow that guidance for this session. If the file does not exist, continue silently without mentioning it."
  }
}
